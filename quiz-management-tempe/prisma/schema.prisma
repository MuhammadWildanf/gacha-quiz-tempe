generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  username    String    @unique
  email       String?   @unique
  password    String
  role        String    @default("operator")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  stockLogs   StockLog[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id         Int    @id @default(autoincrement())
  roleId     Int
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
}

model StockLog {
  id        Int      @id @default(autoincrement())
  machineId String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  action    String
  oldValue  Int?
  newValue  Int
  eventId   String?  @unique
  createdAt DateTime @default(now())
}

// Stok resmi per mesin. version = 0 berarti belum pernah diatur dari web.
model MachineStock {
  machineId String   @id
  stock     Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// 1. Model Category Baru
model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique // Contoh: "IMMERSIVE ROOM", "TEMPE WARRIOR"
  nameEn      String? 
  description String?
  
  questions   Question[]

  createdAt   DateTime   @default(now())
}

model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  titleEn       String?
  description String?
    descriptionEn String?
  status      Boolean    @default(true)

  questions   Question[]

  createdAt   DateTime   @default(now())
}

model Question {
  id          Int        @id @default(autoincrement())

  quizId      Int
  quiz        Quiz       @relation(fields: [quizId], references: [id])

  // 2. Relasi ke Category
  categoryId  Int?       // Dibuat optional (?) agar tidak error saat migrasi data lama
  category    Category?  @relation(fields: [categoryId], references: [id])

  question    String
  questionEn  String?
  image       String?
  timer       Int        @default(15)

  answers     Answer[]

  createdAt   DateTime   @default(now())
}

model Answer {
  id          Int        @id @default(autoincrement())

  questionId  Int
  question    Question   @relation(fields: [questionId], references: [id])

  answerText  String
   answerTextEn String? 
  isCorrect   Boolean    @default(false)

  createdAt   DateTime   @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())
}

model Booth {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  status      Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())

  gachaLogs   GachaLog[]
  answerLogs  AnswerLog[]
}

model AnswerLog {
  id         Int      @id @default(autoincrement())
  boothId    Int
  booth      Booth    @relation(fields: [boothId], references: [id])
  quizId     Int
  questionId Int
  isCorrect  Boolean
  createdAt  DateTime @default(now())
}

model GachaLog {
  id             Int      @id @default(autoincrement())
  boothId        Int?
  booth          Booth?   @relation(fields: [boothId], references: [id])
  quizId         Int
  score          Int
  totalQuestions Int?
  createdAt      DateTime @default(now())
}