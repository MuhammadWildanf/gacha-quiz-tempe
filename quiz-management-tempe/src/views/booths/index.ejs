<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Booths - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .actions-cell { display: flex; gap: 8px; align-items: center; }
        .btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; box-shadow: none; }
        .btn-info { background: rgba(0, 240, 255, 0.1); color: var(--accent-cyan); border: 1px solid rgba(0, 240, 255, 0.2); }
        .btn-info:hover { background: rgba(0, 240, 255, 0.25); transform: translateY(-1px); }
        .btn-warning { background: rgba(255, 165, 0, 0.1); color: #ffa500; border: 1px solid rgba(255, 165, 0, 0.2); }
        .btn-warning:hover { background: rgba(255, 165, 0, 0.25); transform: translateY(-1px); }
        .btn-danger { background: rgba(255, 0, 127, 0.1); color: var(--accent-pink); border: 1px solid rgba(255, 0, 127, 0.2); }
        .btn-danger:hover { background: rgba(255, 0, 127, 0.25); transform: translateY(-1px); }
        .header-actions { display: flex; gap: 12px; }
        .booth-id { font-family: monospace; font-size: 13px; color: var(--accent-cyan); background: rgba(0, 240, 255, 0.08); padding: 2px 8px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo">Quiz<span>Manager</span></div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/admin/dashboard" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/quizzes" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span>Quizzes</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/gacha" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                        <span>Gacha Settings</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/booths" class="sidebar-link active">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        <span>Booths</span>
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <a href="/auth/logout" class="sidebar-link" style="color: #ff007f;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Manage Booths</h1>
                </div>
                <div class="header-actions">
                    <a href="/admin/booths/create" class="btn" style="padding: 10px 20px; font-size: 14px; width: auto; text-decoration: none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Create Booth
                    </a>
                </div>
            </header>

            <% if (success) { %>
                <div style="background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.3); color: #00ff88; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px;">
                    <% if (success === 'created') { %>Booth berhasil ditambahkan.<% } %>
                    <% if (success === 'updated') { %>Booth berhasil diperbarui.<% } %>
                    <% if (success === 'deleted') { %>Booth berhasil dihapus.<% } %>
                </div>
            <% } %>

            <div class="table-card">
                <% if (booths && booths.length > 0) { %>
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nama Booth</th>
                                <th>Deskripsi</th>
                                <th>Status</th>
                                <th>Gacha Logs</th>
                                <th>Answer Logs</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% booths.forEach(booth => { %>
                                <tr>
                                    <td><span class="booth-id">#<%= booth.id %></span></td>
                                    <td style="font-weight: 600;"><%= booth.name %></td>
                                    <td style="color: var(--text-muted);"><%= booth.description || '-' %></td>
                                    <td>
                                        <span class="status-badge <%= booth.status ? 'active' : 'inactive' %>">
                                            <%= booth.status ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td class="text-center"><%= booth._count.gachaLogs %></td>
                                    <td class="text-center"><%= booth._count.answerLogs %></td>
                                    <td>
                                        <div class="actions-cell">
                                            <a href="/admin/booths/edit/<%= booth.id %>" class="btn-sm btn-warning">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                Edit
                                            </a>
                                            <form action="/admin/booths/delete/<%= booth.id %>" method="POST" onsubmit="return confirm('Hapus booth ini beserta semua lognya?');" style="display:inline;">
                                                <button type="submit" class="btn-sm btn-danger">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="no-data">
                        Belum ada booth. Klik "Create Booth" untuk menambahkan.
                    </div>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>
