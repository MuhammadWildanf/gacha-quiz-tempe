<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Booth - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 30px; max-width: 600px; box-shadow: var(--shadow-lg); }
        .btn-group { display: flex; gap: 12px; margin-top: 24px; }
        .btn-secondary { background: rgba(255, 255, 255, 0.05); color: var(--text-main); border: 1px solid var(--glass-border); width: auto; padding: 12px 24px; box-shadow: none; text-decoration: none; display: inline-flex; justify-content: center; align-items: center; border-radius: var(--border-radius); font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; }
        .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }
        .select-input { width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border); border-radius: var(--border-radius); padding: 12px 16px; color: var(--text-main); font-family: var(--font-family); font-size: 15px; transition: all 0.3s ease; }
        .select-input option { background: var(--bg-secondary); color: var(--text-main); }
        .select-input:focus { outline: none; border-color: var(--accent-cyan); background: rgba(255, 255, 255, 0.08); }
        .booth-id-display { font-family: monospace; font-size: 13px; color: var(--accent-cyan); background: rgba(0, 240, 255, 0.08); padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 16px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { activePath: 'booths' }) %>

        <main class="main-content">
            <header class="header-container">
                <div><h1 class="page-title">Edit Booth</h1></div>
            </header>

            <div class="form-card">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message"><%= error %></div>
                <% } %>

                <div class="booth-id-display">Booth ID: #<%= booth.id %> — Gunakan ID ini di Unity</div>

                <form action="/admin/booths/edit/<%= booth.id %>" method="POST">
                    <div class="form-group">
                        <label for="name" class="form-label">Nama Booth</label>
                        <input type="text" id="name" name="name" class="form-input" value="<%= booth.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Deskripsi (Opsional)</label>
                        <textarea id="description" name="description" class="form-input" rows="3"><%= booth.description || '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="status" class="form-label">Status</label>
                        <select id="status" name="status" class="select-input">
                            <option value="true" <%= booth.status ? 'selected' : '' %>>Active</option>
                            <option value="false" <%= !booth.status ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn" style="width: auto; padding: 12px 30px;">Update Booth</button>
                        <a href="/admin/booths" class="btn-secondary">Batal</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
