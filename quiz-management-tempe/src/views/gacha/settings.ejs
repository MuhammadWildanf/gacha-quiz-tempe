<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gacha Settings - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            max-width: 500px;
            box-shadow: var(--shadow-lg);
            margin-bottom: 30px;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .success-message {
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid rgba(0, 240, 255, 0.2);
            color: var(--accent-cyan);
            padding: 12px;
            border-radius: var(--border-radius);
            font-size: 14px;
            margin-bottom: 20px;
            text-align: center;
        }
        .stat-highlight {
            font-size: 48px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent-purple), var(--accent-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
        }
        .stat-label {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { activePath: 'gacha' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Gacha Settings</h1>
                </div>
            </header>

            <% if (success) { %>
                <div class="success-message">Settings saved successfully!</div>
            <% } %>

            <!-- Aturan permainan diatur dari panel Unity (nilai valid), bukan dari web -->
            <div class="form-card">
                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 12px; color: #fff;">Aturan Permainan</h3>
                <p style="color: var(--text-muted); font-size: 14px; line-height: 1.6;">
                    Max soal, poin per jawaban, dan poin menang diatur dari <b>panel Unity</b> (login admin) dan berlaku untuk semua mesin.
                    Halaman ini hanya menampilkan informasi.
                </p>
            </div>

            <!-- Gacha Log History -->
            <section class="quizzes-section">
                <h2 class="section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    Riwayat Gacha (20 Terbaru)
                </h2>

                <div class="table-card">
                    <% if (logs && logs.length > 0) { %>
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Booth</th>
                                    <th>Quiz ID</th>
                                    <th>Skor</th>
                                    <th>Total Soal</th>
                                    <th>Waktu</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% logs.forEach((log, idx) => { %>
                                    <tr>
                                        <td style="color: var(--text-muted);"><%= idx + 1 %></td>
                                        <td><%= log.booth ? log.booth.name : '<span style="color:var(--text-muted);">-</span>' %></td>
                                        <td style="font-weight: 600;"><%= log.quizId %></td>
                                        <td>
                                            <span class="status-badge active"><%= log.score %></span>
                                        </td>
                                        <td style="font-size: 13px;"><%= log.totalQuestions ?? '-' %></td>
                                        <td style="font-size: 13px; color: var(--text-muted);">
                                            <%= new Date(log.createdAt).toLocaleString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-data">
                            Belum ada riwayat gacha.
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
