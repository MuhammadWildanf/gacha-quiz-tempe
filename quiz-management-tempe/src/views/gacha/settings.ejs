<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gacha Settings - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            max-width: 500px;
            box-shadow: var(--shadow-lg);
            margin-bottom: 30px;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .success-message {
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid rgba(0, 240, 255, 0.2);
            color: var(--accent-cyan);
            padding: 12px;
            border-radius: var(--border-radius);
            font-size: 14px;
            margin-bottom: 20px;
            text-align: center;
        }
        .stat-highlight {
            font-size: 48px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent-purple), var(--accent-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
        }
        .stat-label {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                Quiz<span>Manager</span>
            </div>
            
            <ul class="sidebar-menu">
                <li>
                    <a href="/admin/dashboard" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/quizzes" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span>Quizzes</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/gacha" class="sidebar-link active">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                        <span>Gacha Settings</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/booths" class="sidebar-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                        <span>Booths</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="/auth/logout" class="sidebar-link" style="color: #ff007f;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Gacha Settings</h1>
                </div>
            </header>

            <% if (success) { %>
                <div class="success-message">Settings saved successfully!</div>
            <% } %>

            <!-- Current Threshold Display -->
            <section class="stats-grid" style="margin-bottom: 30px;">
                <div class="stat-card">
                    <span class="stat-title">Minimum Jawaban Benar</span>
                    <span class="stat-highlight"><%= setting.minCorrectAnswers %></span>
                    <span class="stat-label">soal untuk mendapatkan hadiah</span>
                </div>
            </section>

            <!-- Edit Threshold Form -->
            <div class="form-card">
                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 20px; color: #fff;">Ubah Threshold</h3>
                <form action="/admin/gacha" method="POST">
                    <div class="form-group">
                        <label for="minCorrectAnswers" class="form-label">Minimum Jawaban Benar</label>
                        <input type="number" id="minCorrectAnswers" name="minCorrectAnswers" class="form-input" value="<%= setting.minCorrectAnswers %>" min="1" required>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn" style="width: auto; padding: 12px 30px;">Simpan</button>
                    </div>
                </form>
            </div>

            <!-- Gacha Log History -->
            <section class="quizzes-section">
                <h2 class="section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    Riwayat Gacha (20 Terbaru)
                </h2>

                <div class="table-card">
                    <% if (logs && logs.length > 0) { %>
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Booth</th>
                                    <th>Quiz ID</th>
                                    <th>Skor</th>
                                    <th>Total Soal</th>
                                    <th>Waktu</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% logs.forEach((log, idx) => { %>
                                    <tr>
                                        <td style="color: var(--text-muted);"><%= idx + 1 %></td>
                                        <td><%= log.booth ? log.booth.name : '<span style="color:var(--text-muted);">-</span>' %></td>
                                        <td style="font-weight: 600;"><%= log.quizId %></td>
                                        <td>
                                            <span class="status-badge active"><%= log.score %></span>
                                        </td>
                                        <td style="font-size: 13px;"><%= log.totalQuestions ?? '-' %></td>
                                        <td style="font-size: 13px; color: var(--text-muted);">
                                            <%= new Date(log.createdAt).toLocaleString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-data">
                            Belum ada riwayat gacha.
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
