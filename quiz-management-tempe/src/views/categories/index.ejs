<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kategori Soal - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .actions-cell { display: flex; gap: 8px; align-items: center; }
        .btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; box-shadow: none; }
        .btn-warning { background: rgba(255, 165, 0, 0.1); color: #ffa500; border: 1px solid rgba(255, 165, 0, 0.2); }
        .btn-warning:hover { background: rgba(255, 165, 0, 0.25); transform: translateY(-1px); }
        .btn-danger { background: rgba(255, 0, 127, 0.1); color: var(--accent-pink); border: 1px solid rgba(255, 0, 127, 0.2); }
        .btn-danger:hover { background: rgba(255, 0, 127, 0.25); transform: translateY(-1px); }
        .flash-ok { background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.3); color: #00ff88; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        .flash-err { background: rgba(255,0,127,0.1); border: 1px solid rgba(255,0,127,0.3); color: var(--accent-pink); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        .header-actions { display: flex; gap: 12px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { activePath: 'categories' }) %>

        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Kategori Soal</h1>
                </div>
                <div class="header-actions">
                    <a href="/admin/categories/create" class="btn" style="padding: 10px 20px; font-size: 14px; width: auto; text-decoration: none;">
                        Tambah Kategori
                    </a>
                </div>
            </header>

            <% if (success) { %>
                <div class="flash-ok">
                    <% if (success === 'created') { %>Kategori berhasil ditambahkan.<% } %>
                    <% if (success === 'updated') { %>Kategori berhasil diperbarui.<% } %>
                    <% if (success === 'deleted') { %>Kategori berhasil dihapus.<% } %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="flash-err">
                    <% if (error === 'delete_failed') { %>Gagal menghapus kategori.<% } else { %><%= error %><% } %>
                </div>
            <% } %>

            <div class="table-card">
                <% if (categories.length > 0) { %>
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Nama</th>
                                <th>Nama (EN)</th>
                                <th>Deskripsi</th>
                                <th>Jumlah Soal</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% categories.forEach(c => { %>
                                <tr>
                                    <td style="font-weight: 600;"><%= c.name %></td>
                                    <td><%= c.nameEn || '-' %></td>
                                    <td style="color: var(--text-muted);"><%= c.description || '-' %></td>
                                    <td class="text-center"><%= c._count.questions %></td>
                                    <td>
                                        <div class="actions-cell">
                                            <a href="/admin/categories/edit/<%= c.id %>" class="btn-sm btn-warning">Edit</a>
                                            <form action="/admin/categories/delete/<%= c.id %>" method="POST" onsubmit="return confirm('Hapus kategori ini? Soal yang memakainya akan menjadi tanpa kategori.');" style="display:inline;">
                                                <button type="submit" class="btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="no-data">Belum ada kategori. Klik "Tambah Kategori" untuk menambahkan.</div>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>
