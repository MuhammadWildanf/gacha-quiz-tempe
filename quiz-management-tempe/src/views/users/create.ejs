<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah User - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 30px; max-width: 600px; box-shadow: var(--shadow-lg); }
        .btn-group { display: flex; gap: 12px; margin-top: 24px; }
        .btn-secondary { background: rgba(255, 255, 255, 0.05); color: var(--text-main); border: 1px solid var(--glass-border); width: auto; padding: 12px 24px; box-shadow: none; text-decoration: none; display: inline-flex; justify-content: center; align-items: center; border-radius: var(--border-radius); font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; }
        .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }
        .hint { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { activePath: 'users' }) %>

        <main class="main-content">
            <header class="header-container">
                <div><h1 class="page-title">Tambah User</h1></div>
            </header>

            <div class="form-card">
                <% if (error) { %>
                    <div class="error-message"><%= error %></div>
                <% } %>

                <form action="/admin/users/create" method="POST">
                    <div class="form-group">
                        <label for="name" class="form-label">Nama</label>
                        <input type="text" id="name" name="name" class="form-input" value="<%= form.name %>" required>
                    </div>

                    <div class="form-group">
                        <label for="username" class="form-label">Username (untuk login)</label>
                        <input type="text" id="username" name="username" class="form-input" value="<%= form.username %>" pattern="[a-zA-Z0-9._]{3,30}" required autocomplete="off">
                        <div class="hint">3-30 karakter: huruf, angka, titik, atau garis bawah.</div>
                    </div>

                    <div class="form-group">
                        <label for="email" class="form-label">Email (opsional)</label>
                        <input type="email" id="email" name="email" class="form-input" value="<%= form.email || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" id="password" name="password" class="form-input" minlength="6" required autocomplete="new-password">
                        <div class="hint">Minimal 6 karakter.</div>
                    </div>

                    <div class="form-group">
                        <label for="role" class="form-label">Role</label>
                        <select id="role" name="role" class="select-input" required>
                            <% roles.forEach(r => { %>
                                <option value="<%= r %>" <%= form.role === r ? 'selected' : '' %>><%= r %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" style="display:flex; gap:8px; align-items:center;">
                            <input type="checkbox" name="isActive" <%= form.isActive ? 'checked' : '' %>>
                            Akun aktif
                        </label>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn" style="width: auto; padding: 12px 30px;">Simpan User</button>
                        <a href="/admin/users" class="btn-secondary">Batal</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
