<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .actions-cell { display: flex; gap: 8px; align-items: center; }
        .btn-sm { padding: 6px 12px; font-size: 13px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; box-shadow: none; }
        .btn-warning { background: rgba(255, 165, 0, 0.1); color: #ffa500; border: 1px solid rgba(255, 165, 0, 0.2); }
        .btn-warning:hover { background: rgba(255, 165, 0, 0.25); transform: translateY(-1px); }
        .btn-danger { background: rgba(255, 0, 127, 0.1); color: var(--accent-pink); border: 1px solid rgba(255, 0, 127, 0.2); }
        .btn-danger:hover { background: rgba(255, 0, 127, 0.25); transform: translateY(-1px); }
        .header-actions { display: flex; gap: 12px; }
        .mono { font-family: monospace; font-size: 13px; color: var(--accent-cyan); }
        .flash-ok { background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.3); color: #00ff88; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        .flash-err { background: rgba(255,0,127,0.1); border: 1px solid rgba(255,0,127,0.3); color: var(--accent-pink); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { activePath: 'users' }) %>

        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Manage Users</h1>
                </div>
                <div class="header-actions">
                    <a href="/admin/users/create" class="btn" style="padding: 10px 20px; font-size: 14px; width: auto; text-decoration: none;">
                        Tambah User
                    </a>
                </div>
            </header>

            <% if (success) { %>
                <div class="flash-ok">
                    <% if (success === 'created') { %>User berhasil ditambahkan.<% } %>
                    <% if (success === 'updated') { %>User berhasil diperbarui.<% } %>
                    <% if (success === 'deleted') { %>User berhasil dihapus.<% } %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="flash-err"><%= error %></div>
            <% } %>

            <div class="table-card">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nama</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Login Terakhir</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td><span class="mono">#<%= u.id %></span></td>
                                <td style="font-weight: 600;"><%= u.name %><% if (u.id === currentUserId) { %> <span style="color: var(--text-muted); font-weight: 400;">(kamu)</span><% } %></td>
                                <td class="mono"><%= u.username %></td>
                                <td style="color: var(--text-muted);"><%= u.email || '-' %></td>
                                <td><%= u.role %></td>
                                <td>
                                    <span class="status-badge <%= u.isActive ? 'active' : 'inactive' %>">
                                        <%= u.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                </td>
                                <td style="color: var(--text-muted);"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString('id-ID') : 'Belum pernah' %></td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/admin/users/edit/<%= u.id %>" class="btn-sm btn-warning">Edit</a>
                                        <% if (u.id !== currentUserId) { %>
                                            <form action="/admin/users/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Hapus user <%= u.username %>?');" style="display:inline;">
                                                <button type="submit" class="btn-sm btn-danger">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>
