<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Quiz - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 30px;
            max-width: 600px;
            box-shadow: var(--shadow-lg);
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--glass-border);
            width: auto;
            padding: 12px 24px;
            box-shadow: none;
            text-decoration: none;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            border-radius: var(--border-radius);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        .select-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: var(--border-radius);
            padding: 12px 16px;
            color: var(--text-main);
            font-family: var(--font-family);
            font-size: 15px;
            transition: all 0.3s ease;
        }
        .select-input option {
            background: var(--bg-secondary);
            color: var(--text-main);
        }
        .select-input:focus {
            outline: none;
            border-color: var(--accent-cyan);
            background: rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { activePath: 'quizzes' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Edit Quiz</h1>
                </div>
            </header>

            <div class="form-card">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/admin/quizzes/edit/<%= quiz.id %>" method="POST">
                    <div class="form-group">
                        <label for="title" class="form-label">Quiz Title</label>
                        <input type="text" id="title" name="title" class="form-input" value="<%= quiz.title %>" placeholder="Enter quiz title">
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Description (Optional)</label>
                        <textarea id="description" name="description" class="form-input" rows="4"><%= quiz.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="status" class="form-label">Status</label>
                        <select id="status" name="status" class="select-input">
                            <option value="true" <%= quiz.status ? 'selected' : '' %>>Active (Visible to Unity)</option>
                            <option value="false" <%= !quiz.status ? 'selected' : '' %>>Inactive (Hidden)</option>
                        </select>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn" style="width: auto; padding: 12px 30px;">Update Quiz</button>
                        <a href="/admin/quizzes" class="btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
