<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Quiz Management System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('partials/sidebar', { activePath: 'dashboard' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Dashboard Overview</h1>
                </div>
                <div class="user-badge">
                    <div class="avatar"><%= user.name.charAt(0) %></div>
                    <span><%= user.name %></span>
                </div>
            </header>

            <!-- Stats Grid -->
            <section class="stats-grid">
                <div class="stat-card">
                    <span class="stat-title">Total Quizzes</span>
                    <span class="stat-value"><%= stats.totalQuizzes %></span>
                </div>
                <div class="stat-card cyan">
                    <span class="stat-title">Total Questions</span>
                    <span class="stat-value"><%= stats.totalQuestions %></span>
                </div>
                <div class="stat-card cyan">
                    <span class="stat-title">Total Booths</span>
                    <span class="stat-value"><%= stats.totalBooths || 0 %></span>
                </div>
            </section>

            <!-- Recent Quizzes -->
            <section class="quizzes-section">
                <h2 class="section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 8px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    Recent Quizzes
                </h2>

                <div class="table-card">
                    <% if (activeQuizzes && activeQuizzes.length > 0) { %>
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>Questions Count</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% activeQuizzes.forEach(quiz => { %>
                                    <tr>
                                        <td style="font-weight: 600;"><%= quiz.title %></td>
                                        <td style="color: var(--text-muted);"><%= quiz.description || 'No description' %></td>
                                        <td class="text-center"><%= quiz._count.questions %></td>
                                        <td>
                                            <span class="status-badge <%= quiz.status ? 'active' : 'inactive' %>">
                                                <%= quiz.status ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td style="font-size: 13px; color: var(--text-muted);">
                                            <%= new Date(quiz.createdAt).toLocaleDateString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-data">
                            No quizzes created yet. Let's create your first quiz!
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
