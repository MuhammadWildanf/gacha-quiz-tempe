<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roles & Izin - Quiz Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .role-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 24px; margin-bottom: 24px; box-shadow: var(--shadow-lg); }
        .role-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .role-name { font-size: 18px; font-weight: 700; }
        .role-desc { font-size: 13px; color: var(--text-muted); }
        .perm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
        .perm-item { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 1px solid var(--glass-border); border-radius: 8px; font-size: 14px; }
        .perm-key { font-family: monospace; font-size: 12px; color: var(--accent-cyan); }
        .perm-item.disabled { opacity: 0.6; }
        .flash-ok { background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.3); color: #00ff88; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        .btn-save { width: auto; padding: 10px 24px; }
        .locked-note { font-size: 13px; color: var(--text-muted); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { activePath: 'roles' }) %>

        <main class="main-content">
            <header class="header-container">
                <div>
                    <h1 class="page-title">Roles & Izin</h1>
                </div>
            </header>

            <% if (success) { %>
                <div class="flash-ok">
                    <% if (success === 'saved') { %>Izin role berhasil disimpan.<% } %>
                    <% if (success === 'locked') { %>Role admin selalu punya semua izin dan tidak bisa diubah.<% } %>
                </div>
            <% } %>

            <% matrix.forEach(role => { %>
                <form class="role-card" action="/admin/roles/<%= role.id %>" method="POST">
                    <div class="role-head">
                        <div>
                            <div class="role-name"><%= role.name %></div>
                            <div class="role-desc"><%= role.description || '' %></div>
                        </div>
                        <% if (role.locked) { %>
                            <span class="locked-note">Terkunci (selalu semua izin)</span>
                        <% } else { %>
                            <button type="submit" class="btn btn-save">Simpan Izin</button>
                        <% } %>
                    </div>

                    <div class="perm-grid">
                        <% permissionKeys.forEach(key => { %>
                            <label class="perm-item <%= role.locked ? 'disabled' : '' %>">
                                <input type="checkbox" name="permissions" value="<%= key %>"
                                    <%= (role.locked || role.granted.has(key)) ? 'checked' : '' %>
                                    <%= role.locked ? 'disabled' : '' %>>
                                <span>
                                    <%= permissionLabels[key] %><br>
                                    <span class="perm-key"><%= key %></span>
                                </span>
                            </label>
                        <% }) %>
                    </div>
                </form>
            <% }) %>
        </main>
    </div>
</body>
</html>
