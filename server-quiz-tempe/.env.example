# ==========================================
# Konfigurasi Integrasi Vendor API (Spesifikasi v1.0)
# ==========================================

SCAN_MODE=VENDOR_API

# Alamat Server API Vendor
VENDOR_BASE_URL=http://localhost:4000

# API Key berawalan mk_
VENDOR_API_KEY=mk_example_key

# Secret untuk HMAC-SHA256 (jangan dibagikan / jangan di-commit publik)
VENDOR_SECRET=example_secret_key

# Nomor seri unik mesin gacha (bisa lebih dari satu, pisahkan dengan koma)
DEVICE_SNS=gacha-001,gacha-002,gacha-003

# Port server (VPS: pastikan dibuka di firewall / reverse proxy)
PORT=3012

# Nilai AWAL aturan main (bisa diubah kapan saja dari dashboard tanpa restart;
# setelah disimpan dari dashboard, settings_local.json yang jadi acuan)
MAX_GAME_ATTEMPTS=3
WIN_MIN_PERCENTAGE=80
